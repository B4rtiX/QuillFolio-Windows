<UserControl x:Class="Quillfolio.WPF.Controls.TableOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
             mc:Ignorable="d"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False">

    <Border x:Name="CardBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="12"
            Padding="0">
        <StackPanel>
            <!-- Focus-only Floating Table Action Bar -->
            <Grid x:Name="ActionBar" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DragHandle"
                        Grid.Column="0"
                        Background="{DynamicResource PillTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8,4"
                        Cursor="SizeAll"
                        ToolTip="{Binding [TableDragTip], Source={x:Static svc:Loc.Instance}}">
                    <TextBlock Text="⋮⋮" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource PillTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAddRow" Content="{Binding [TableAddRow], Source={x:Static svc:Loc.Instance}}" Click="BtnAddRow_Click" Margin="1,0" Padding="7,3" FontSize="11" Style="{StaticResource FluentButtonStyle}" />
                        <Button x:Name="BtnDelRow" Content="{Binding [TableDelRow], Source={x:Static svc:Loc.Instance}}" Click="BtnDelRow_Click" Margin="1,0" Padding="7,3" FontSize="11" Style="{StaticResource FluentButtonStyle}" />
                        <Button x:Name="BtnAddCol" Content="{Binding [TableAddCol], Source={x:Static svc:Loc.Instance}}" Click="BtnAddCol_Click" Margin="1,0" Padding="7,3" FontSize="11" Style="{StaticResource FluentButtonStyle}" />
                        <Button x:Name="BtnDelCol" Content="{Binding [TableDelCol], Source={x:Static svc:Loc.Instance}}" Click="BtnDelCol_Click" Margin="1,0" Padding="7,3" FontSize="11" Style="{StaticResource FluentButtonStyle}" />
                        <Button x:Name="BtnCellColor" Content="{Binding [TableColorBtn], Source={x:Static svc:Loc.Instance}}" Click="BtnCellColor_Click" Margin="2,0" Padding="7,3" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Style="{StaticResource FluentButtonStyle}" ToolTip="{Binding [TableColorTip], Source={x:Static svc:Loc.Instance}}" />
                        <Popup x:Name="PopupCellColor" PlacementTarget="{Binding ElementName=BtnCellColor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="6" Width="232">
                                <StackPanel>
                                    <TextBlock Text="{Binding [TableCellBgHeader], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <WrapPanel x:Name="CellBgSwatches" Margin="0,0,0,6" />
                                    <Button x:Name="BtnCustomCellBg" Content="{Binding [TableCustomCellBg], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource OutlineButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,0,8" Click="BtnCustomCellBg_Click" />
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding [TableCellTextHeader], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <WrapPanel x:Name="CellTextSwatches" Margin="0,0,0,6" />
                                    <Button x:Name="BtnCustomCellText" Content="{Binding [TableCustomCellText], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource OutlineButtonStyle}" Padding="6,4" FontSize="11" Click="BtnCustomCellText_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button x:Name="BtnDeleteTable"
                                Content="✕"
                                Click="BtnDeleteTable_Click"
                                PreviewStylusDown="BtnDeleteTable_PreviewStylusDown"
                                PreviewStylusUp="BtnDeleteTable_PreviewStylusUp"
                                Stylus.IsPressAndHoldEnabled="False"
                                Stylus.IsFlicksEnabled="False"
                                Stylus.IsTapFeedbackEnabled="False"
                                Margin="3,0,0,0"
                                Width="28" Height="26"
                                Padding="0"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#DC2626"
                                Style="{StaticResource FluentButtonStyle}"
                                ToolTip="{Binding [TableDeleteTip], Source={x:Static svc:Loc.Instance}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dynamic Table Grid -->
            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="TableGrid" SnapsToDevicePixels="True" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
