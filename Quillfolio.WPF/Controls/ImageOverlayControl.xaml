<UserControl x:Class="Quillfolio.WPF.Controls.ImageOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
             mc:Ignorable="d"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False">

    <Border x:Name="FrameBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1.5"
            CornerRadius="6"
            Padding="0">
        <Grid>
            <Image x:Name="ImgContent"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Focus-only Floating Top Bar (Drag & Delete) -->
            <DockPanel x:Name="HeaderBar"
                       VerticalAlignment="Top"
                       Margin="6"
                       Visibility="Collapsed">
                <Border x:Name="DragHandle"
                        DockPanel.Dock="Left"
                        Background="#CC0F172A"
                        CornerRadius="6"
                        Padding="8,4"
                        Cursor="SizeAll"
                        ToolTip="{Binding [DragImageTip], Source={x:Static svc:Loc.Instance}}">
                    <TextBlock Text="⋮⋮" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                </Border>

                <Button x:Name="BtnDelete"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="✕"
                        Click="BtnDelete_Click"
                        PreviewStylusDown="BtnDelete_PreviewStylusDown"
                        PreviewStylusUp="BtnDelete_PreviewStylusUp"
                        Stylus.IsPressAndHoldEnabled="False"
                        Stylus.IsFlicksEnabled="False"
                        Stylus.IsTapFeedbackEnabled="False"
                        Width="28" Height="26"
                        Padding="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Background="#EEFFFFFF"
                        Foreground="#DC2626"
                        Style="{StaticResource FluentButtonStyle}"
                        ToolTip="{Binding [DeleteImageTip], Source={x:Static svc:Loc.Instance}}" />
            </DockPanel>

            <!-- Bottom-Right Resize Grip (Visible only when focused) -->
            <Border x:Name="ResizeHandle"
                    Width="20" Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,-4,-4"
                    Background="#EEFFFFFF"
                    BorderBrush="#7C3AED"
                    BorderThickness="1.5"
                    CornerRadius="6"
                    Cursor="SizeNWSE"
                    Visibility="Collapsed"
                    ToolTip="{Binding [ResizeTip], Source={x:Static svc:Loc.Instance}}">
                <Path Width="10" Height="10" Stretch="Uniform" Fill="#7C3AED"
                      Data="M14,14H12V12H14V14M14,10H12V8H14V10M10,14H8V12H10V14Z" />
            </Border>
        </Grid>
    </Border>
</UserControl>
