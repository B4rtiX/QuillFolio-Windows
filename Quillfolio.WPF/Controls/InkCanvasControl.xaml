<UserControl x:Class="Quillfolio.WPF.Controls.InkCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Focusable="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             ClipToBounds="True">
    <Grid x:Name="RootGrid" Background="{DynamicResource DeskBackgroundBrush}">
        <!-- Zoom & Pan Viewport -->
        <ScrollViewer x:Name="CanvasScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <Border Margin="36,92,36,92"
                    CornerRadius="4"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Border.LayoutTransform>
                    <MatrixTransform x:Name="CanvasMatrixTransform" />
                </Border.LayoutTransform>
                <Canvas x:Name="PaperCanvas"
                        Width="2400"
                        Height="3200"
                        Background="#FFFFFF">
                    <!-- Inserted Images Layer (sits below Ink so users can annotate on top of images) -->
                    <Canvas x:Name="ImagesLayer"
                            Width="2400"
                            Height="3200" />

                    <!-- Vector Drawing Surface (Custom Invalidation Visual) -->
                    <Canvas x:Name="VectorLayer"
                            Width="2400"
                            Height="3200"
                            IsHitTestVisible="False" />

                    <!-- Interactive Overlays Layer (Tables, Sticky Notes) -->
                    <Canvas x:Name="OverlayLayer"
                            Width="2400"
                            Height="3200" />

                    <!-- Floating Selection HUD Layer (Duplicate / Delete Pill) -->
                    <Canvas x:Name="SelectionHudLayer"
                            Width="2400"
                            Height="3200" />

                    <!-- Top-most Cursor Overlay Layer (Eraser ring above all sheets, tables, notes, HUD) -->
                    <Canvas x:Name="TopCursorLayer"
                            Width="2400"
                            Height="3200"
                            IsHitTestVisible="False" />
                </Canvas>
            </Border>
        </ScrollViewer>

        <!-- Fixed Viewport Layer for screen-pinned sticky notes -->
        <Canvas x:Name="PinnedOverlayLayer"
                Background="{x:Null}"
                ClipToBounds="True" />
    </Grid>
</UserControl>
