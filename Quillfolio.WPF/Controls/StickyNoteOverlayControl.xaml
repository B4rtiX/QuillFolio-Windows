<UserControl x:Class="Quillfolio.WPF.Controls.StickyNoteOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
             mc:Ignorable="d"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False">

    <Border x:Name="NoteBorder"
            Background="#FEF08A"
            BorderBrush="#7C3AED"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="10"
            MinWidth="160"
            MinHeight="72">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Focus-only Header Bar (Drag, Pin-to-screen & Stylus-safe Delete) -->
            <DockPanel x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,6">
                <Border x:Name="DragHandle"
                        DockPanel.Dock="Left"
                        Background="#280F172A"
                        CornerRadius="6"
                        Padding="8,4"
                        Cursor="SizeAll"
                        ToolTip="{Binding [DragTip], Source={x:Static svc:Loc.Instance}}">
                    <TextBlock Text="⋮⋮" FontWeight="Bold" FontSize="12" Foreground="#1E293B" />
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPin"
                            Click="BtnPin_Click"
                            PreviewStylusDown="BtnPin_PreviewStylusDown"
                            PreviewStylusUp="BtnPin_PreviewStylusUp"
                            Stylus.IsPressAndHoldEnabled="False"
                            Stylus.IsFlicksEnabled="False"
                            Stylus.IsTapFeedbackEnabled="False"
                            Height="28"
                            Padding="8,0"
                            Margin="0,0,4,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Style="{StaticResource FluentButtonStyle}"
                            ToolTip="Przypnij do ekranu">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="PinBtnIcon"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Fill="#475569"
                                  Margin="0,0,4,0"
                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                            <TextBlock x:Name="TxtPinLabel" Text="Przypnij" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDelete"
                            Content="✕"
                            Click="BtnDelete_Click"
                            PreviewStylusDown="BtnDelete_PreviewStylusDown"
                            PreviewStylusUp="BtnDelete_PreviewStylusUp"
                            Stylus.IsPressAndHoldEnabled="False"
                            Stylus.IsFlicksEnabled="False"
                            Stylus.IsTapFeedbackEnabled="False"
                            Width="30" Height="28"
                            Padding="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#DC2626"
                            Style="{StaticResource FluentButtonStyle}"
                            ToolTip="{Binding [DeleteTip], Source={x:Static svc:Loc.Instance}}" />
                </StackPanel>
            </DockPanel>

            <!-- Compact passive indicator when pinned to screen & unfocused -->
            <Border x:Name="PinnedBadge"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#EAE5FF"
                    BorderBrush="#C4B5FD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="5,2"
                    Margin="0,0,0,3"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="{Binding [StickyPinnedTip], Source={x:Static svc:Loc.Instance}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#7C3AED" Margin="0,0,3,0"
                          Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                    <TextBlock x:Name="TxtPinnedBadge" Text="Ekran" FontSize="9.5" FontWeight="SemiBold" Foreground="#6D28D9" />
                </StackPanel>
            </Border>

            <!-- Editable Formatted Text Content -->
            <Grid Grid.Row="1">
                <TextBox x:Name="TxtContent"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontSize="15"
                         FontFamily="Segoe UI"
                         Foreground="#111827"
                         VerticalScrollBarVisibility="Auto" />

                <!-- Bottom-Right Resize Grip (Visible only when focused) -->
                <Border x:Name="ResizeHandle"
                        Width="16" Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-6,-6"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        ToolTip="{Binding [ResizeTip], Source={x:Static svc:Loc.Instance}}">
                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#64748B"
                          Data="M14,14H12V12H14V14M14,10H12V8H14V10M10,14H8V12H10V14Z" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
