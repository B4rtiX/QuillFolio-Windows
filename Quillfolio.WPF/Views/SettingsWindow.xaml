<Window x:Class="Quillfolio.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        Title="{Binding [Settings], Source={x:Static svc:Loc.Instance}}"
        Width="580" Height="700"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="{DynamicResource DeskBackgroundBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle"
                       Text="Ustawienia"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Quillfolio Studio Preferences"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Scrollable Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <!-- Language Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="LblLang" Text="Język interfejsu" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbPolish" Content="Polski 🇵🇱" Checked="RbPolish_Checked" Margin="0,0,24,0" FontSize="13" />
                                <RadioButton x:Name="RbEnglish" Content="English 🇬🇧" Checked="RbEnglish_Checked" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Paper Appearance Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblPaper" Text="Podkład papieru" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CmbPaperStyle" SelectionChanged="CmbPaperStyle_SelectionChanged" Padding="8,6">
                                    <ComboBoxItem x:Name="ItemPaperBlank" Content="Czysty" />
                                    <ComboBoxItem x:Name="ItemPaperRuled" Content="Linie" />
                                    <ComboBoxItem x:Name="ItemPaperGrid" Content="Kratka" />
                                    <ComboBoxItem x:Name="ItemPaperDotted" Content="Kropki" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblPaperColor" Text="Kolor papieru" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CmbPaperColor" SelectionChanged="CmbPaperColor_SelectionChanged" Padding="8,6">
                                    <ComboBoxItem x:Name="ItemColorWhite" Content="Biały" />
                                    <ComboBoxItem x:Name="ItemColorCream" Content="Kremowy" />
                                    <ComboBoxItem x:Name="ItemColorYellow" Content="Żółty notatnik" />
                                    <ComboBoxItem x:Name="ItemColorSlate" Content="Ciemny łupkowy" />
                                    <ComboBoxItem x:Name="ItemColorChalk" Content="Tablica szkolna" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LblGuidelineSpacing" Text="Rozstaw linii / kratki (px)" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,6" />
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSpacingVal" Text="28 px" Width="44" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderGuidelineSpacing" Minimum="16" Maximum="64" Value="28" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="SliderGuidelineSpacing_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Ink, Stylus & Shape Recognition Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkSmoothing" Content="Wygładzanie krzywych (Catmull-Rom Spline)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Checked="ChkSmoothing_Changed" Unchecked="ChkSmoothing_Changed" />
                        <CheckBox x:Name="ChkShapeSnap" Content="Automatyczne rozpoznawanie i poprawianie figur (Hold &amp; Snap)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" Checked="ChkShapeSnap_Changed" Unchecked="ChkShapeSnap_Changed" />

                        <TextBlock x:Name="LblStylus" Text="Czułość nacisku rysika" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSensitivityVal" Text="1.0x" Width="38" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderSensitivity" Minimum="0.5" Maximum="2.5" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderSensitivity_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock x:Name="LblHoldDelay" Text="Czas przytrzymania figury (ms)" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHoldDelayVal" Text="450 ms" Width="48" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderHoldDelay" Minimum="250" Maximum="800" Value="450" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SliderHoldDelay_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>

                        <CheckBox x:Name="ChkAutoSelectShapes" Content="{Binding [AutoSelectShapesEnabled], Source={x:Static svc:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" Checked="ChkAutoSelectShapes_Changed" Unchecked="ChkAutoSelectShapes_Changed" />

                        <TextBlock x:Name="LblNibAngle" Text="{Binding [NibAngleLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNibAngleVal" Text="38°" Width="44" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderNibAngle" Minimum="15" Maximum="75" Value="38" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderNibAngle_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock x:Name="LblEraserSize" Text="{Binding [EraserSizeLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEraserSizeVal" Text="2.2x" Width="44" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderEraserSize" Minimum="1.2" Maximum="4.0" Value="2.2" TickFrequency="0.2" IsSnapToTickEnabled="True" ValueChanged="SliderEraserSize_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock x:Name="LblLaserFade" Text="{Binding [LaserFadeLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLaserFadeVal" Text="1100 ms" Width="56" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                            <Slider x:Name="SliderLaserFade" Minimum="500" Maximum="3000" Value="1100" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SliderLaserFade_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Workspace & Defaults Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="LblWorkspace" Text="{Binding [WorkspaceHeader], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <TextBlock x:Name="LblAppTheme" Text="Motyw aplikacji" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbAppTheme" SelectionChanged="CmbAppTheme_SelectionChanged" Padding="8,6" Margin="0,0,0,12">
                            <ComboBoxItem x:Name="ItemThemeLight" Tag="Light" Content="Jasny (Nordic Studio)" />
                            <ComboBoxItem x:Name="ItemThemeDark" Tag="Dark" Content="Ciemny (Studio Dark)" />
                            <ComboBoxItem x:Name="ItemThemeOled" Tag="Oled" Content="OLED (Głęboka czerń)" />
                            <ComboBoxItem x:Name="ItemThemeSystem" Tag="System" Content="Systemowy (Windows)" />
                        </ComboBox>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblDeskTheme" Text="{Binding [DeskThemeLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbDeskTheme" SelectionChanged="CmbDeskTheme_SelectionChanged" Padding="8,6">
                                    <ComboBoxItem Tag="NordicFrost" Content="{Binding [DeskNordicFrost], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="WarmSand" Content="{Binding [DeskWarmSand], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="SlateMist" Content="{Binding [DeskSlateMist], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="DeepStudio" Content="{Binding [DeskDeepStudio], Source={x:Static svc:Loc.Instance}}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblDefaultTool" Text="{Binding [DefaultToolLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbDefaultTool" SelectionChanged="CmbDefaultTool_SelectionChanged" Padding="8,6">
                                    <ComboBoxItem Tag="Cursor" Content="{Binding [ToolCursor], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="Pen" Content="{Binding [ToolPen], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="FountainPen" Content="{Binding [ToolFountainPen], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="Pencil" Content="{Binding [ToolPencil], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="Highlighter" Content="{Binding [ToolHighlighter], Source={x:Static svc:Loc.Instance}}" />
                                    <ComboBoxItem Tag="Select" Content="{Binding [ToolSelect], Source={x:Static svc:Loc.Instance}}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LblDefaultPageSize" Text="{Binding [DefaultPageSizeLabel], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbDefaultPageSize" SelectionChanged="CmbDefaultPageSize_SelectionChanged" Padding="8,6">
                            <ComboBoxItem Tag="2400x3200" Content="{Binding [PageSizeStandard], Source={x:Static svc:Loc.Instance}}" />
                            <ComboBoxItem Tag="2100x2970" Content="{Binding [PageSizeA4], Source={x:Static svc:Loc.Instance}}" />
                            <ComboBoxItem Tag="3200x2400" Content="{Binding [PageSizeLandscape], Source={x:Static svc:Loc.Instance}}" />
                            <ComboBoxItem Tag="3200x4200" Content="{Binding [PageSizeLarge], Source={x:Static svc:Loc.Instance}}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Keyboard Shortcuts Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="BtnResetShortcuts" DockPanel.Dock="Right" Content="Przywróć domyślne" Style="{StaticResource OutlineButtonStyle}" Padding="10,4" FontSize="11.5" Click="BtnResetShortcuts_Click" />
                            <TextBlock x:Name="LblShortcutsTitle" Text="Skróty klawiszowe (kliknij Zmień, aby dostosować)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="8">
                            <StackPanel x:Name="ShortcutsListHost" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Storage Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <DockPanel>
                        <Button x:Name="BtnOpenDataFolder" DockPanel.Dock="Right" Content="Otwórz folder" Style="{StaticResource OutlineButtonStyle}" Click="BtnOpenDataFolder_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel>
                            <TextBlock x:Name="LblDataFolder" Text="Folder danych" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtDataPath" Text="%APPDATA%\Quillfolio\quillfolio_data.json" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="B4rtiX"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="BtnClose" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Zamknij" Style="{StaticResource PrimaryButtonStyle}" Click="BtnClose_Click" Width="120" Height="36" />
        </DockPanel>
    </Grid>
</Window>
