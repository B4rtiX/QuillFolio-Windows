<Window x:Class="Quillfolio.WPF.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        Title="{Binding [IconPickerTitle], Source={x:Static svc:Loc.Instance}}"
        Width="440" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="{DynamicResource DeskBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [IconPickerHeader], Source={x:Static svc:Loc.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding [IconPickerSubtitle], Source={x:Static svc:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="IconsGrid" Columns="4" />
            </ScrollViewer>
        </Border>

        <Border x:Name="ColorCard"
                Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,10"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding [IconAccentColor], Source={x:Static svc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding [Cancel], Source={x:Static svc:Loc.Instance}}" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Width="96" Height="34" Margin="0,0,8,0" />
            <Button Content="{Binding [Apply], Source={x:Static svc:Loc.Instance}}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="BtnOk_Click" Width="106" Height="34" />
        </StackPanel>
    </Grid>
</Window>
