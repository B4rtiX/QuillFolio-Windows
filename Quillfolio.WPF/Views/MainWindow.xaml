<Window x:Class="Quillfolio.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Quillfolio.WPF.Controls"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        mc:Ignorable="d"
        Title="Quillfolio"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1380" Height="880"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Background="{DynamicResource DeskBackgroundBrush}">

    <Grid Background="{DynamicResource DeskBackgroundBrush}">
        <!-- ================================================================ -->
        <!-- LAYER 0: WORKSPACE (FLOATING SIDEBAR + INFINITE CANVAS DESK)      -->
        <!-- ================================================================ -->
        <Grid Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="296" MinWidth="0" MaxWidth="420" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- FLOATING GLASS SIDEBAR DRAWER -->
            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    Style="{StaticResource FloatingIslandStyle}"
                    Margin="14,88,2,14"
                    CornerRadius="16"
                    Padding="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SidebarScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="SidebarTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Primary Action: New Note -->
                    <Border Grid.Row="0" Padding="14,14,14,10">
                        <Button x:Name="BtnNewNote"
                                Content="+ Nowa notatka"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                FontSize="13"
                                Click="BtnNewNote_Click" />
                    </Border>

                    <!-- Folders & Favorites Tab Switcher + Explorer Card -->
                    <StackPanel Grid.Row="1">
                        <Border Margin="14,0,14,10"
                                Padding="3"
                                Background="{DynamicResource PillTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="BtnTabFolders"
                                             Grid.Column="0"
                                             Content="Foldery"
                                             IsChecked="True"
                                             Checked="SidebarTab_Changed"
                                             Style="{StaticResource ToolButtonStyle}"
                                             HorizontalContentAlignment="Center"
                                             Padding="6,5"
                                             FontSize="12" />
                                <RadioButton x:Name="BtnTabFavorites"
                                             Grid.Column="1"
                                             Content="★ Ulubione"
                                             Checked="SidebarTab_Changed"
                                             Style="{StaticResource ToolButtonStyle}"
                                             HorizontalContentAlignment="Center"
                                             Padding="6,5"
                                             FontSize="12" />
                            </Grid>
                        </Border>

                        <Border x:Name="FoldersExplorerCard"
                                Margin="14,0,14,10"
                                Padding="10,8"
                                Background="{DynamicResource PillTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <DockPanel Margin="2,0,2,6">
                                    <TextBlock x:Name="LblFoldersHeader"
                                               Text="FOLDERY"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnToggleExpandAll"
                                                Content="▾"
                                                Padding="6,2"
                                                FontSize="10.5"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Click="BtnToggleExpandAll_Click"
                                                ToolTip="{Binding [ToggleExpandAllTip], Source={x:Static svc:Loc.Instance}}" />
                                        <Button x:Name="BtnAddCategory"
                                                Content="+ Folder"
                                                Padding="7,2"
                                                FontSize="10.5"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Click="BtnAddCategory_Click"
                                                ToolTip="Dodaj folder" />
                                        <Button x:Name="BtnAddSubcategory"
                                                Content="+ Podfolder"
                                                Padding="7,2"
                                                FontSize="10.5"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Click="BtnAddSubcategory_Click"
                                                ToolTip="Dodaj podfolder" />
                                    </StackPanel>
                                </DockPanel>

                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="FoldersTreePanel" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Search Pill -->
                    <Border Grid.Row="2"
                            Margin="14,0,14,10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Data="M15.5,14h-.79l-.28-.27A6.471,6.471,0,0,0,16,9.5,6.5,6.5,0,1,0,9.5,16c1.61,0,3.09-.59,4.23-1.57l.27.28v.79l5,4.99L20.49,19Zm-6,0C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5,14,7.01,14,9.5,11.99,14,9.5,14Z" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="TxtSearchNotes"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12.5"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtSearchNotes_TextChanged" />
                                <TextBlock x:Name="TxtSearchPlaceholder"
                                           Text="Szukaj notatek..."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Active Folder Breadcrumb / Scope Bar -->
                    <Border x:Name="ActiveScopeBar"
                            Grid.Row="3"
                            Margin="14,0,14,6"
                            Padding="10,5"
                            Background="{DynamicResource PillTrackBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource SelectionTintBrush}"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtScopeNoteCount"
                                           Text="0"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <StackPanel x:Name="BreadcrumbPanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Modern Note Cards List -->
                    <ListBox x:Name="ListNotes"
                             Grid.Row="4"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             SelectionChanged="ListNotes_SelectionChanged"
                             PreviewMouseLeftButtonDown="ListNotes_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ListNotes_PreviewMouseMove"
                             Padding="10,2,10,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,10"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Border x:Name="AccentPill"
                                                            Width="3.5"
                                                            HorizontalAlignment="Left"
                                                            Margin="-6,2,0,2"
                                                            CornerRadius="2"
                                                            Background="Transparent" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectionTintBrush}" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ActiveBorderBrush}" />
                                                    <Setter TargetName="AccentPill" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0,0,0" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [FavoritesTab], Source={x:Static svc:Loc.Instance}}" Click="MenuNoteToggleFavorite_Click" Tag="{Binding}" />
                                            <MenuItem Header="{Binding [Rename], Source={x:Static svc:Loc.Instance}}" Click="BtnRenameNote_Click" Tag="{Binding}" />
                                            <MenuItem Header="{Binding [MoveNoteTip], Source={x:Static svc:Loc.Instance}}" Click="BtnMoveNote_Click" Tag="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{Binding [DeleteTip], Source={x:Static svc:Loc.Instance}}" Foreground="#DC2626" Click="BtnDeleteNote_Click" Tag="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="BtnToggleFavorite_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="2,4,6,4" Cursor="Hand" VerticalAlignment="Center" ToolTip="{Binding [ToggleFavoriteTip], Source={x:Static svc:Loc.Instance}}">
                                        <TextBlock FontSize="14" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="★" />
                                                            <Setter Property="Foreground" Value="#F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{DynamicResource PillTrackBrush}"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PageCountDisplay}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding UpdatedAtDisplay}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnMoveNote_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="{Binding [MoveNoteTip], Source={x:Static svc:Loc.Instance}}">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4M14,13V10L18,14L14,18V15H10V13H14Z" />
                                        </Button>
                                        <Button Click="BtnRenameNote_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="{Binding [RenameTip], Source={x:Static svc:Loc.Instance}}">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25ZM20.71,7.04a1,1,0,0,0,0-1.41l-2.34-2.34a1,1,0,0,0-1.41,0l-1.83,1.83,3.75,3.75,1.83-1.83Z" />
                                        </Button>
                                        <Button Click="BtnDeleteNote_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="{Binding [DeleteTip], Source={x:Static svc:Loc.Instance}}">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#EF4444" Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter x:Name="MainGridSplitter"
                          Grid.Column="1"
                          Width="6"
                          Margin="0,88,0,14"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <!-- INFINITE CANVAS DESK -->
            <controls:InkCanvasControl x:Name="MainInkCanvas" Grid.Column="2" />

            <!-- ============================================================ -->
            <!-- LAYER 1: BOTTOM FLOATING CANVAS HUD PILL (COLLAPSIBLE)       -->
            <!-- ============================================================ -->
            <Grid Grid.Column="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="16,0,16,14">
                <Border x:Name="BottomHudIsland"
                        Style="{StaticResource FloatingIslandStyle}"
                        CornerRadius="16"
                        Padding="8,5"
                        RenderTransformOrigin="0.5,1.0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BottomHudScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="BottomHudTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Page Navigation Pill -->
                        <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="3" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPrevPage" Content="◀" Style="{StaticResource FluentButtonStyle}" Click="BtnPrevPage_Click" Padding="8,4" FontSize="11" />
                                <TextBlock x:Name="TxtPageIndicator"
                                           Text="1 / 1"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button x:Name="BtnNextPage" Content="▶" Style="{StaticResource FluentButtonStyle}" Click="BtnNextPage_Click" Padding="8,4" FontSize="11" />
                                <Button x:Name="BtnAddPage" Content="+ Strona" Style="{StaticResource FluentButtonStyle}" Click="BtnAddPage_Click" Padding="9,4" Margin="4,0,0,0" FontSize="12" />
                                <Button x:Name="BtnDeletePage" Content="Usuń stronę" Style="{StaticResource FluentButtonStyle}" Click="BtnDeletePage_Click" Padding="9,4" FontSize="12" Foreground="#DC2626" />
                            </StackPanel>
                        </Border>

                        <!-- Canvas Expansion Pill -->
                        <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="3" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnExpandWidth" Content="+800px ↔" Style="{StaticResource FluentButtonStyle}" Click="BtnExpandWidth_Click" Padding="8,4" FontSize="11.5" ToolTip="{Binding [ExpandWidthTip], Source={x:Static svc:Loc.Instance}}" />
                                <Button x:Name="BtnExpandHeight" Content="+1000px ↕" Style="{StaticResource FluentButtonStyle}" Click="BtnExpandHeight_Click" Padding="8,4" FontSize="11.5" ToolTip="{Binding [ExpandHeightTip], Source={x:Static svc:Loc.Instance}}" />
                            </StackPanel>
                        </Border>

                        <!-- Zoom Pill -->
                        <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="3" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnZoomOut" Content="−" Click="BtnZoomOut_Click" Style="{StaticResource FluentButtonStyle}" Width="26" Padding="2,4" FontWeight="Bold" ToolTip="Oddal (Ctrl+-)" />
                                <Button x:Name="BtnZoomReset" Content="100%" Click="BtnZoomReset_Click" Style="{StaticResource FluentButtonStyle}" Padding="7,4" FontSize="11.5" FontWeight="SemiBold" ToolTip="Reset widoku (100%)" />
                                <Button x:Name="BtnZoomIn" Content="+" Click="BtnZoomIn_Click" Style="{StaticResource FluentButtonStyle}" Width="26" Padding="2,4" FontWeight="Bold" ToolTip="Przybliż (Ctrl+=)" />
                            </StackPanel>
                        </Border>

                        <!-- Clear & Export Pill -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearPage" Content="Wyczyść" Style="{StaticResource OutlineButtonStyle}" Click="BtnClearPage_Click" Padding="9,5" Margin="0,0,6,0" FontSize="12" />
                            <Button x:Name="BtnExportPng" Content="PNG" Style="{StaticResource OutlineButtonStyle}" Click="BtnExportPng_Click" Padding="9,5" Margin="0,0,6,0" FontSize="12" />
                            <Button x:Name="BtnExportPdf" Content="Eksport PDF" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExportPdf_Click" Padding="11,5" FontSize="12" />
                        </StackPanel>

                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="8,0,4,0" />
                        <Button x:Name="BtnToggleBottomBar"
                                Content="▾"
                                Style="{StaticResource FluentButtonStyle}"
                                Click="BtnToggleBottomBar_Click"
                                Padding="7,4"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                ToolTip="Ukryj dolny pasek" />
                    </WrapPanel>
                </Border>

                <!-- Minimized Bottom Bar Restore Handle -->
                <Border x:Name="BottomHudRestoreIsland"
                        Visibility="Collapsed"
                        Style="{StaticResource FloatingIslandStyle}"
                        CornerRadius="12"
                        Padding="4,2"
                        RenderTransformOrigin="0.5,1.0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BottomHudRestoreScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="BottomHudRestoreTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Button x:Name="BtnRestoreBottomBar"
                            Content="▲"
                            Style="{StaticResource FluentButtonStyle}"
                            Click="BtnToggleBottomBar_Click"
                            Padding="14,3"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            ToolTip="Pokaż dolny pasek" />
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- LAYER 2: TOP FLOATING COMMAND DOCK + CONTEXTUAL TEXT FORMAT BAR  -->
        <!-- ================================================================ -->
        <StackPanel Panel.ZIndex="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Margin="14,12,14,0">

            <!-- Main Floating Command Dock -->
            <Border Style="{StaticResource FloatingIslandStyle}"
                    CornerRadius="16"
                    Padding="8,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Home Screen Button -->
                    <Button x:Name="BtnHome"
                            Style="{StaticResource OutlineButtonStyle}"
                            Width="36" Height="34"
                            Padding="0"
                            Margin="0,0,6,0"
                            Click="BtnHome_Click"
                            ToolTip="Ekran główny / Home">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                    </Button>

                    <!-- Sidebar Toggle Button -->
                    <Button x:Name="BtnToggleSidebar"
                            Style="{StaticResource OutlineButtonStyle}"
                            Width="36" Height="34"
                            Padding="0"
                            Margin="0,0,8,0"
                            Click="BtnToggleSidebar_Click"
                            ToolTip="Pokaż / Ukryj listę notatek">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M3,5A2,2 0 0,1 5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5M5,5V19H9V5H5M11,5V19H19V5H11Z" />
                    </Button>

                    <!-- Segmented Drawing Tools Pill (with sliding active pill indicator) -->
                    <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="11" Padding="3" Margin="0,0,8,0">
                        <Grid x:Name="DrawingToolsHost">
                            <Border x:Name="ActiveToolIndicator"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Width="0"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    BorderBrush="{DynamicResource ActiveBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ActiveToolIndicatorTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.10" Color="#6D28D9" />
                                </Border.Effect>
                            </Border>

                            <StackPanel x:Name="DrawingToolsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Cursor / Object Move Tool -->
                                <RadioButton x:Name="BtnCursor" GroupName="DrawingTools" Style="{StaticResource SlidingToolRadioStyle}" Checked="Tool_Checked" PreviewMouseLeftButtonDown="ToolRadio_PreviewPointerDown" PreviewStylusDown="ToolRadio_PreviewStylusDown" PreviewStylusUp="ToolRadio_PreviewStylusUp" Tag="7" ToolTip="{Binding [CursorToolTip], Source={x:Static svc:Loc.Instance}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M7,2L19,12L13.5,13L16.5,19.5L14.2,20.5L11.2,14L7,17.5V2Z" />
                                        <TextBlock x:Name="LblToolCursor" Text="Kursor" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Ballpoint Pen (Długopis) -->
                                <RadioButton x:Name="BtnPen" GroupName="DrawingTools" Style="{StaticResource SlidingToolRadioStyle}" IsChecked="True" Checked="Tool_Checked" PreviewMouseLeftButtonDown="ToolRadio_PreviewPointerDown" PreviewStylusDown="ToolRadio_PreviewStylusDown" PreviewStylusUp="ToolRadio_PreviewStylusUp" Tag="0" ToolTip="{Binding [PenToolTip], Source={x:Static svc:Loc.Instance}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" />
                                        <TextBlock x:Name="LblToolPen" Text="Długopis" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Classic Fountain Pen (Pióro) -->
