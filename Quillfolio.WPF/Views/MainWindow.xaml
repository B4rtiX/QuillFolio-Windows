                                </Border>
                                <Border CornerRadius="12" Padding="2" BorderThickness="2" BorderBrush="Transparent" Tag="#D97706" Margin="1,0">
                                    <Button Background="#D97706" BorderBrush="#B45309" Click="Color_Click" Tag="#D97706" ToolTip="{Binding [ColorAmber], Source={x:Static svc:Loc.Instance}}" />
                                </Border>
                                <Border CornerRadius="12" Padding="2" BorderThickness="2" BorderBrush="Transparent" Tag="#9333EA" Margin="1,0">
                                    <Button Background="#9333EA" BorderBrush="#7E22CE" Click="Color_Click" Tag="#9333EA" ToolTip="{Binding [ColorPurple], Source={x:Static svc:Loc.Instance}}" />
                                </Border>
                                <Border CornerRadius="12" Padding="2" BorderThickness="2" BorderBrush="Transparent" Tag="#EC4899" Margin="1,0">
                                    <Button Background="#EC4899" BorderBrush="#DB2777" Click="Color_Click" Tag="#EC4899" ToolTip="{Binding [ColorPink], Source={x:Static svc:Loc.Instance}}" />
                                </Border>
                            </StackPanel>

                            <Button x:Name="BtnCustomColor" Click="BtnCustomColor_Click" Style="{StaticResource FluentButtonStyle}" Padding="5,4" Margin="2,0,4,0" ToolTip="Własny kolor / Custom Color">
                                <Grid Width="18" Height="18">
                                    <Ellipse StrokeThickness="2">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EF4444" Offset="0" />
                                                <GradientStop Color="#F59E0B" Offset="0.25" />
                                                <GradientStop Color="#10B981" Offset="0.5" />
                                                <GradientStop Color="#3B82F6" Offset="0.75" />
                                                <GradientStop Color="#A855F7" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                    </Ellipse>
                                    <Ellipse x:Name="CustomColorDot" Width="10" Height="10" Fill="#1E1E1E" />
                                </Grid>
                            </Button>

                            <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="2,0,4,0" />

                            <Button x:Name="BtnThicknessDropdown" Click="BtnThicknessDropdown_Click" Style="{StaticResource FluentButtonStyle}" Padding="8,4" ToolTip="Grubość linii / Line Thickness">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Line X1="0" Y1="7" X2="22" Y2="7" x:Name="LineThicknessPreview" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="14" />
                                    <TextBlock x:Name="TxtThicknessValue" Text="3.5 px ▾" Margin="6,0,0,0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Popup x:Name="PopupThickness" PlacementTarget="{Binding ElementName=BtnThicknessDropdown}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="8" Width="244">
                                    <StackPanel>
                                        <StackPanel x:Name="ThicknessPresetsPanel" Margin="0,0,0,10" />
                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="LblCustomThickness" Text="Własna grubość (px)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtCustomThickness" DockPanel.Dock="Right" Width="54" Text="3.5" HorizontalContentAlignment="Center" Padding="4,3" KeyDown="TxtCustomThickness_KeyDown" LostFocus="TxtCustomThickness_LostFocus" />
                                        </DockPanel>
                                        <Slider x:Name="SliderCustomThickness" Minimum="0.5" Maximum="30" Value="3.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SliderCustomThickness_ValueChanged" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- History & Settings Pill -->
                    <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="11" Padding="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnUndo" Style="{StaticResource FluentButtonStyle}" Click="BtnUndo_Click" Padding="8,5" ToolTip="Cofnij (Ctrl+Z)">
                                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" />
                            </Button>
                            <Button x:Name="BtnRedo" Style="{StaticResource FluentButtonStyle}" Click="BtnRedo_Click" Padding="8,5" ToolTip="Ponów (Ctrl+Y)">
                                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" />
                            </Button>
                            <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="3,0" />
                            <Button x:Name="BtnSettings" Click="BtnSettings_Click" Style="{StaticResource FluentButtonStyle}" Padding="9,5" ToolTip="Ustawienia / Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                    <TextBlock x:Name="LblSettings" Text="Ustawienia" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- Contextual Text Formatting Bar (Visible only when a text box / sticky note is focused) -->
            <Border x:Name="TextFormattingBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Style="{StaticResource FloatingIslandStyle}"
                    CornerRadius="14"
                    Padding="10,5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TextFormattingBarTranslate" X="0" Y="0" />
                </Border.RenderTransform>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Font Family & Size -->
                    <ComboBox x:Name="CmbTextFontFamily" Width="122" Height="28" FontSize="11.5" Margin="0,0,4,0" SelectionChanged="CmbTextFontFamily_SelectionChanged">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Arial" />
                        <ComboBoxItem Content="Georgia" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Consolas" />
                        <ComboBoxItem Content="Comic Sans MS" />
                    </ComboBox>

                    <ComboBox x:Name="CmbTextFontSize" Width="58" Height="28" FontSize="11.5" Margin="0,0,4,0" SelectionChanged="CmbTextFontSize_SelectionChanged">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="15" IsSelected="True" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="32" />
                        <ComboBoxItem Content="40" />
                        <ComboBoxItem Content="48" />
                    </ComboBox>

                    <Button Content="A−" Style="{StaticResource FluentButtonStyle}" Padding="6,4" FontSize="11" Click="BtnTextFontSmaller_Click" ToolTip="{Binding [FontSmallerTip], Source={x:Static svc:Loc.Instance}}" />
                    <Button Content="A+" Style="{StaticResource FluentButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,6,0" Click="BtnTextFontLarger_Click" ToolTip="{Binding [FontLargerTip], Source={x:Static svc:Loc.Instance}}" />

                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="2,0,6,0" />

                    <!-- Style Toggles -->
                    <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="9" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnTextBold" Content="B" FontWeight="Bold" Width="28" Height="26" Padding="0" Style="{StaticResource ToolButtonStyle}" Click="BtnTextFormat_Click" ToolTip="{Binding [BoldTip], Source={x:Static svc:Loc.Instance}}" />
                            <ToggleButton x:Name="BtnTextItalic" Content="I" FontStyle="Italic" Width="28" Height="26" Padding="0" Style="{StaticResource ToolButtonStyle}" Click="BtnTextFormat_Click" ToolTip="{Binding [ItalicTip], Source={x:Static svc:Loc.Instance}}" />
                            <ToggleButton x:Name="BtnTextUnderline" Width="28" Height="26" Padding="0" Style="{StaticResource ToolButtonStyle}" Click="BtnTextFormat_Click" ToolTip="{Binding [UnderlineTip], Source={x:Static svc:Loc.Instance}}">
                                <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" />
                            </ToggleButton>
                            <ToggleButton x:Name="BtnTextStrike" Width="28" Height="26" Padding="0" Style="{StaticResource ToolButtonStyle}" Click="BtnTextFormat_Click" ToolTip="{Binding [StrikeTip], Source={x:Static svc:Loc.Instance}}">
                                <TextBlock Text="S" TextDecorations="Strikethrough" FontWeight="SemiBold" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Alignment & Bullets -->
                    <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="9" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAlignLeft" Content="≡L" Width="28" Height="26" FontSize="10.5" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextAlign_Click" Tag="Left" ToolTip="{Binding [AlignLeftTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="BtnAlignCenter" Content="≡C" Width="28" Height="26" FontSize="10.5" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextAlign_Click" Tag="Center" ToolTip="{Binding [AlignCenterTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="BtnAlignRight" Content="≡R" Width="28" Height="26" FontSize="10.5" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextAlign_Click" Tag="Right" ToolTip="{Binding [AlignRightTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="BtnAlignJustify" Content="≡J" Width="28" Height="26" FontSize="10.5" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextAlign_Click" Tag="Justify" ToolTip="{Binding [AlignJustifyTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button Content="{Binding [BulletsLabel], Source={x:Static svc:Loc.Instance}}" Height="26" FontSize="11" Padding="7,0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextBullets_Click" ToolTip="{Binding [BulletsTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button Content="Tx" Width="28" Height="26" FontSize="11" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="BtnTextClearFormat_Click" ToolTip="{Binding [ClearFormatTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="BtnTextSymbols" Content="∑ Symbole ▾" Height="26" FontSize="11" FontWeight="SemiBold" Padding="7,0" Focusable="False" Foreground="{DynamicResource PrimaryBrush}" Style="{StaticResource FluentButtonStyle}" Click="BtnTextSymbols_Click" ToolTip="{Binding [SymbolsTip], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Popup x:Name="PopupTextSymbols" PlacementTarget="{Binding ElementName=BtnTextSymbols}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="8" Width="368">
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SymbolsCategoryHost" Margin="0,0,4,0" />
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!-- Text Color Dots -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="A:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Button Background="#111827" BorderBrush="#94A3B8" Click="BtnTextColor_Click" Tag="#111827" ToolTip="{Binding [ColorBlackTextTip], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#FFFFFF" BorderBrush="#94A3B8" Click="BtnTextColor_Click" Tag="#FFFFFF" ToolTip="{Binding [ColorWhiteTextTip], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#2563EB" BorderBrush="#1D4ED8" Click="BtnTextColor_Click" Tag="#2563EB" ToolTip="{Binding [ColorBlueTextTip], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#DC2626" BorderBrush="#B91C1C" Click="BtnTextColor_Click" Tag="#DC2626" ToolTip="{Binding [ColorRedTextTip], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#16A34A" BorderBrush="#15803D" Click="BtnTextColor_Click" Tag="#16A34A" ToolTip="{Binding [ColorGreenTextTip], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#7C3AED" BorderBrush="#6D28D9" Click="BtnTextColor_Click" Tag="#7C3AED" ToolTip="{Binding [ColorPurpleTextTip], Source={x:Static svc:Loc.Instance}}" />
                    </StackPanel>
                    <Button Content="🎨" Style="{StaticResource FluentButtonStyle}" Padding="5,3" FontSize="12" Margin="0,0,6,0" Click="BtnTextCustomColor_Click" ToolTip="{Binding [CustomTextColorTip], Source={x:Static svc:Loc.Instance}}" />

                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="2,0,6,0" />

                    <!-- Note / Box Background Swatches -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding [BgColorLabel], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Button Background="#FEF08A" BorderBrush="#CA8A04" Click="BtnNoteBgColor_Click" Tag="#FEF08A" ToolTip="{Binding [ColorYellowBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#BFDBFE" BorderBrush="#2563EB" Click="BtnNoteBgColor_Click" Tag="#BFDBFE" ToolTip="{Binding [ColorBlueBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#BBF7D0" BorderBrush="#16A34A" Click="BtnNoteBgColor_Click" Tag="#BBF7D0" ToolTip="{Binding [ColorGreenBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#FBCFE8" BorderBrush="#DB2777" Click="BtnNoteBgColor_Click" Tag="#FBCFE8" ToolTip="{Binding [ColorPinkBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#EDE9FE" BorderBrush="#7C3AED" Click="BtnNoteBgColor_Click" Tag="#EDE9FE" ToolTip="{Binding [ColorLavenderBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="#FFFFFF" BorderBrush="#94A3B8" Click="BtnNoteBgColor_Click" Tag="#FFFFFF" ToolTip="{Binding [ColorWhiteBg], Source={x:Static svc:Loc.Instance}}" />
                        <Button Background="Transparent" BorderBrush="#94A3B8" Content="∅" FontSize="10" Foreground="#64748B" Click="BtnNoteBgColor_Click" Tag="Transparent" ToolTip="{Binding [ColorTransparentBg], Source={x:Static svc:Loc.Instance}}" />
                    </StackPanel>

                    <Button x:Name="BtnDeleteActiveTextBox" Content="🗑️" Style="{StaticResource FluentButtonStyle}" Padding="7,4" Foreground="#DC2626" Click="BtnDeleteActiveTextBox_Click" ToolTip="{Binding [DeleteTextBoxTip], Source={x:Static svc:Loc.Instance}}" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- LAYER 3: MODERN HOME SCREEN OVERLAY                              -->
        <!-- ================================================================ -->
        <Grid x:Name="HomeScreenOverlay"
              Panel.ZIndex="50"
              Visibility="Collapsed"
              Background="{DynamicResource DeskBackgroundBrush}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HomeScreenTranslate" X="0" Y="0" />
            </Grid.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1060" HorizontalAlignment="Center" Margin="36,30,36,44">

                    <!-- Home Header Bar -->
                    <Border Style="{StaticResource FloatingIslandStyle}" CornerRadius="20" Padding="24,18" Margin="0,0,0,22">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource SelectionTintBrush}" BorderBrush="{DynamicResource ActiveBorderBrush}" BorderThickness="1" Margin="0,0,16,0" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="40" Height="40" Stretch="Uniform" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="Fant" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LblHomeTitle" Text="Witaj w Quillfolio" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="LblHomeSubtitle" Text="Cyfrowy zeszyt z wektorowym atramentem, tabelami i kształtami" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnHomeOpenCanvas" Content="Otwórz kanwę →" Style="{StaticResource OutlineButtonStyle}" Padding="14,9" Margin="0,0,10,0" FontSize="13" Click="BtnHomeOpenCanvas_Click" />
                                <Button x:Name="BtnHomeNewNoteTop" Content="+ Nowa notatka" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" Margin="0,0,10,0" FontSize="13" Click="BtnHomeNewNote_Click" />
                                <Button x:Name="BtnHomeSettings" Style="{StaticResource OutlineButtonStyle}" Width="38" Height="38" Padding="0" Click="BtnSettings_Click" ToolTip="{Binding [Settings], Source={x:Static svc:Loc.Instance}}">
                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Quick Action Cards Row -->
                    <UniformGrid Columns="4" Margin="0,0,0,26">
                        <Button Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" Padding="18,16" HorizontalContentAlignment="Left" Click="BtnHomeNewNote_Click" Cursor="Hand">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SelectionTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [NewNote], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding [HomeNewNoteDesc], Source={x:Static svc:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}" Margin="5,0,5,0" Padding="18,16" HorizontalContentAlignment="Left" Click="BtnHomeContinueLast_Click" Cursor="Hand">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SelectionTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="LblHomeContinue" Text="Kontynuuj ostatnią" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LblHomeLastNoteTitle" Text="Ostatnia edytowana" FontSize="11.5" Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}" Margin="5,0,5,0" Padding="18,16" HorizontalContentAlignment="Left" Click="BtnHomeChooseImage_Click" Cursor="Hand">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SelectionTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="🖼️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [HomeInsertImageTitle], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding [HomeInsertImageDesc], Source={x:Static svc:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}" Margin="10,0,0,0" Padding="18,16" HorizontalContentAlignment="Left" Click="BtnSettings_Click" Cursor="Hand">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SelectionTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="🎨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding [HomeThemeSettingsTitle], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LblHomeStats" Text="{Binding [HomeThemesSubtitle], Source={x:Static svc:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Favorite Notes Section -->
                    <StackPanel x:Name="HomeFavoritesSection" Margin="0,0,0,24">
                        <TextBlock x:Name="LblHomeFavorites" Text="★ ULUBIONE NOTATKI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,10" />
                        <WrapPanel x:Name="HomeFavoritesPanel" />
                    </StackPanel>

                    <!-- Recent Notes Section -->
                    <StackPanel>
                        <TextBlock x:Name="LblHomeRecent" Text="OSTATNIE NOTATKI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,10" />
                        <WrapPanel x:Name="HomeRecentNotesPanel" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================ -->
        <!-- LAYER 4: STARTUP LOADING SCREEN ANIMATION OVERLAY                -->
        <!-- ================================================================ -->
        <Grid x:Name="LoadingScreenOverlay"
              Panel.ZIndex="100"
              Visibility="Visible"
              Background="{DynamicResource DeskBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="108" Height="108" Margin="0,0,0,20">
                    <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="4" />
                    <Ellipse x:Name="LoadingSpinnerRing"
                             Stroke="{DynamicResource PrimaryBrush}"
                             StrokeThickness="4.5"
                             StrokeDashArray="16 28"
                             StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingSpinnerRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="76" Height="76" CornerRadius="22" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="56" Height="56" Stretch="Uniform" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="Fant" />
                    </Border>
                </Grid>

                <TextBlock Text="Quillfolio"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding [LoadingPreparing], Source={x:Static svc:Loc.Instance}}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,18" />

                <Border Width="210" Height="5" CornerRadius="2.5" Background="{DynamicResource PillTrackBrush}" ClipToBounds="True">
                    <Border x:Name="LoadingProgressFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="2.5"
                            Background="{DynamicResource PrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
