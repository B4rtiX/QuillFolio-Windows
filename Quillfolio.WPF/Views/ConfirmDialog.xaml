<Window x:Class="Quillfolio.WPF.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Width="420"
            Margin="18"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="18"
            Padding="22">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <Border x:Name="IconBadge"
                        Width="40" Height="40"
                        CornerRadius="12"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <Path x:Name="IconPath"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Fill="#DC2626"
                          Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16Z"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="{Binding [ConfirmTitle], Source={x:Static svc:Loc.Instance}}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtMessage"
                               Text="{Binding [ConfirmDefaultMsg], Source={x:Static svc:Loc.Instance}}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               LineHeight="19" />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="BtnCancel"
                        Content="{Binding [Cancel], Source={x:Static svc:Loc.Instance}}"
                        IsCancel="True"
                        Style="{StaticResource OutlineButtonStyle}"
                        MinWidth="96" Height="36"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click" />
                <Button x:Name="BtnConfirm"
                        Content="{Binding [Confirm], Source={x:Static svc:Loc.Instance}}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="112" Height="36"
                        Click="BtnConfirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
