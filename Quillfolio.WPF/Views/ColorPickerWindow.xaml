<Window x:Class="Quillfolio.WPF.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        Title="{Binding [ColorPickerTitle], Source={x:Static svc:Loc.Instance}}"
        Width="448" SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="{DynamicResource DeskBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <StackPanel>
                <!-- Color Preview & HEX Input Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,10">
                    <DockPanel>
                        <Border x:Name="PreviewBorder"
                                Width="54" Height="40"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [ColorHexLabel], Source={x:Static svc:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtHex" FontSize="13.5" FontWeight="SemiBold" Padding="8,4" TextChanged="TxtHex_TextChanged" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Interactive Color Wheel & Brightness Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [ColorWheelTitle], Source={x:Static svc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <Grid Width="180" Height="180" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Canvas x:Name="WheelCanvas"
                                    Width="180" Height="180"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="WheelCanvas_MouseDown"
                                    MouseMove="WheelCanvas_MouseMove"
                                    MouseLeftButtonUp="WheelCanvas_MouseUp"
                                    StylusDown="WheelCanvas_StylusDown"
                                    StylusMove="WheelCanvas_StylusMove"
                                    StylusUp="WheelCanvas_StylusUp">
                                <Image x:Name="WheelImage"
                                       Width="180" Height="180"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       IsHitTestVisible="False" />
                                <Ellipse x:Name="WheelThumbOuter"
                                         Width="16" Height="16"
                                         Stroke="#FFFFFF"
                                         StrokeThickness="2.5"
                                         IsHitTestVisible="False" />
                                <Ellipse x:Name="WheelThumbInner"
                                         Width="16" Height="16"
                                         Stroke="#0F172A"
                                         StrokeThickness="1"
                                         IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>

                        <DockPanel>
                            <TextBlock Text="{Binding [ColorBrightness], Source={x:Static svc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtValuePct" Text="100%" Width="42" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Slider x:Name="SliderValue" Minimum="0.05" Maximum="1.0" Value="1.0" TickFrequency="0.01" ValueChanged="SliderValue_ValueChanged" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Suggested Swatches Card (all 20 colors clearly visible, never clipped) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding [ColorSuggested], Source={x:Static svc:Loc.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8" />
                        <UniformGrid x:Name="SwatchesPanel" Columns="10" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Always-visible Action Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding [Cancel], Source={x:Static svc:Loc.Instance}}" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Width="100" Height="36" />
            <Button x:Name="BtnOk" Content="{Binding [Apply], Source={x:Static svc:Loc.Instance}}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="BtnOk_Click" Width="120" Height="36" />
        </StackPanel>
    </Grid>
</Window>
