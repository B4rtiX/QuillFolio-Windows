<Window x:Class="Quillfolio.WPF.Views.AxesConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Quillfolio.WPF.Services"
        Title="{Binding [AxesTitle], Source={x:Static svc:Loc.Instance}}"
        Width="445" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="{DynamicResource DeskBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtHeaderTitle" Text="{Binding [AxesTitle], Source={x:Static svc:Loc.Instance}}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding [AxesSubtitle], Source={x:Static svc:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <StackPanel>
                <!-- Min X -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Min X" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValMinX" Text="-5" Width="34" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderMinX" Minimum="-30" Maximum="-1" Value="-5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Max X -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Max X" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValMaxX" Text="5" Width="34" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderMaxX" Minimum="1" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Min Y -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Min Y" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValMinY" Text="-5" Width="34" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderMinY" Minimum="-30" Maximum="-1" Value="-5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Max Y -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Max Y" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValMaxY" Text="5" Width="34" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderMaxY" Minimum="1" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Step -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding [AxesStep], Source={x:Static svc:Loc.Instance}}" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValStep" Text="1" Width="34" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderStep" Minimum="1" Maximum="10" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Size -->
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding [AxesSize], Source={x:Static svc:Loc.Instance}}" Width="62" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillTrackBrush}" CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="ValSize" Text="360 px" Width="52" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Slider x:Name="SliderSize" Minimum="160" Maximum="1000" Value="360" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" />
                </DockPanel>

                <Border Background="{DynamicResource PillTrackBrush}" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkShowXAxis" Content="{Binding [AxesShowX], Source={x:Static svc:Loc.Instance}}" IsChecked="True" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />
                        <CheckBox x:Name="ChkShowYAxis" Content="{Binding [AxesShowY], Source={x:Static svc:Loc.Instance}}" IsChecked="True" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7" />
                        <CheckBox x:Name="ChkShowLabels" Content="{Binding [AxesShowLabels], Source={x:Static svc:Loc.Instance}}" IsChecked="True" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding [Cancel], Source={x:Static svc:Loc.Instance}}" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Width="100" Height="34" />
            <Button x:Name="BtnInsert" Content="{Binding [Insert], Source={x:Static svc:Loc.Instance}}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="BtnInsert_Click" Width="125" Height="34" />
        </StackPanel>
    </Grid>
</Window>
